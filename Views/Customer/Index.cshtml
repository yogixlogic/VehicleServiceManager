@model List<VehicleServiceManager.Models.Customer>

<h1>Customers</h1>

<a asp-controller="Customer"
   asp-action="Create"
   class="btn btn-primary">
    Add Customer
</a>

<br />
<br />
<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Address</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var customer in Model)
        {
            <tr>
                <td>@customer.Id</td>
                <td>@customer.Name</td>
                <td>@customer.Phone</td>
                <td>@customer.Email</td>
                <td>@customer.Address</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@customer.Id"
                       class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete"
                       asp-route-id="@customer.Id"
                       class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
